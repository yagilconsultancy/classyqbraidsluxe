{
  "name": "Availability",
  "type": "object",
  "properties": {
    "day_of_week": {
      "type": "number",
      "description": "0=Sunday, 6=Saturday"
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM or display format (e.g. 9:00 AM) for time-specific blocks"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM format"
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "slot_duration_minutes": {
      "type": "number",
      "default": 60
    },
    "specific_date": {
      "type": "string",
      "format": "date",
      "description": "For blocking specific dates or time slots"
    },
    "is_blocked": {
      "type": "boolean",
      "default": false
    },
    "block_reason": {
      "type": "string"
    },
    "booking_reference": {
      "type": "string",
      "description": "Links to the booking that created this time block (auto-generated)"
    }
  },
  "required": []
}