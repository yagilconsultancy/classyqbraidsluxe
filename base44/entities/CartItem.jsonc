{
  "name": "CartItem",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Browser session identifier"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "product_image": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "price": {
      "type": "number"
    },
    "selected_length": {
      "type": "string"
    },
    "selected_color": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "product_id",
    "product_name",
    "price"
  ]
}