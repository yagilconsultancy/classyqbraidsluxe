{
  "name": "Booking",
  "type": "object",
  "properties": {
    "reference_number": {
      "type": "string"
    },
    "hairstyle_id": {
      "type": "string"
    },
    "hairstyle_name": {
      "type": "string"
    },
    "hair_type": {
      "type": "string",
      "enum": [
        "human_hair",
        "synthetic_hair",
        "curly_extensions",
        "straight_extensions",
        "body_wave_hair"
      ]
    },
    "hair_size": {
      "type": "string",
      "enum": [
        "extra_small",
        "small",
        "small_medium",
        "medium",
        "large",
        "extra_large"
      ]
    },
    "hair_length": {
      "type": "string",
      "enum": [
        "shoulder",
        "mid_back",
        "waist",
        "hip",
        "custom"
      ]
    },
    "inspiration_link": {
      "type": "string",
      "description": "Optional video or picture link the client shared as a style reference"
    },
    "inspiration_media": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Uploaded inspiration photos/videos the client shared as a style reference"
    },
    "appointment_date": {
      "type": "string",
      "format": "date"
    },
    "appointment_time": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "total_price": {
      "type": "number"
    },
    "requires_quote": {
      "type": "boolean",
      "default": false,
      "description": "True when the selected hair size requires a custom price quote"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "refunded"
      ],
      "default": "unpaid"
    },
    "payment_id": {
      "type": "string"
    },
    "extension_products": {
      "type": "array",
      "description": "Extension products the client wants to purchase from the salon with this booking",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "length": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        }
      }
    },
    "reminder_72h_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the 72-hour reminder email has been sent to the client"
    },
    "reminder_24h_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the 24-hour reminder email has been sent to the client"
    }
  },
  "required": [
    "hairstyle_name",
    "customer_name",
    "customer_email",
    "appointment_date",
    "appointment_time"
  ]
}