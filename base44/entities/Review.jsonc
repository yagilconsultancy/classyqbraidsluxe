{
  "name": "Review",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "comment": {
      "type": "string"
    },
    "hairstyle_name": {
      "type": "string"
    },
    "is_approved": {
      "type": "boolean",
      "default": false
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "customer_name",
    "rating",
    "comment"
  ]
}