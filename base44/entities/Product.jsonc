{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "product_type": {
      "type": "string",
      "enum": [
        "extension",
        "hairstyle",
        "hair_care"
      ]
    },
    "category": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "description": "Base/default price"
    },
    "sale_price": {
      "type": "number"
    },
    "length_prices": {
      "type": "object",
      "description": "Price per length for extensions, e.g. { '10\"': 45, '14\"': 60 }"
    },
    "lengths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available lengths (derived from length_prices keys)"
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available colors"
    },
    "inventory_count": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "price"
  ]
}